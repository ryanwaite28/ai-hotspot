generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id                        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  handle                    String
  displayName               String                 @map("display_name")
  email                     String
  passwordHash              String?                @map("password_hash")
  status                    String                 @default("pending_verification")
  role                      String                 @default("user")
  identityVerificationStatus String                @default("pending") @map("identity_verification_status")
  identityVerificationRef   String?                @map("identity_verification_ref")
  flaggedForReview          Boolean                @default(false) @map("flagged_for_review")
  flaggedReason             String?                @map("flagged_reason")
  trialActivatedOnce        Boolean                @default(false) @map("trial_activated_once")
  trialStartedAt            DateTime?              @map("trial_started_at") @db.Timestamptz(6)
  trialEndsAt               DateTime?              @map("trial_ends_at") @db.Timestamptz(6)
  exportRequestedAt         DateTime?              @map("export_requested_at") @db.Timestamptz(6)
  deactivatedAt             DateTime?              @map("deactivated_at") @db.Timestamptz(6)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt                 DateTime?              @map("deleted_at") @db.Timestamptz(6)
  authSessions              AuthSession[]
  verificationSessions      VerificationSession[]
  verificationCallbackEvents VerificationCallbackEvent[]
  passkeyChallenges         PasskeyChallenge[]
  passkeyCredentials        PasskeyCredential[]
  profileSettings           ProfileSettings?
  outgoingFollows           Follow[]           @relation("FollowFollower")
  incomingFollows           Follow[]           @relation("FollowFollowing")
  outgoingBlocks            Block[]            @relation("BlockBlocker")
  incomingBlocks            Block[]            @relation("BlockBlocked")
  outgoingMutes             Mute[]             @relation("MuteMuter")
  incomingMutes             Mute[]             @relation("MuteMuted")
  posts                     Post[]
  postLikes                 PostLike[]
  postBookmarks             PostBookmark[]
  mediaUploadSessions       MediaUploadSession[]
  mediaAssets               MediaAsset[]        @relation("MediaOwner")
  mediaComments             MediaComment[]      @relation("MediaCommentAuthor")

  @@unique([handle], map: "users_handle_unique")
  @@unique([email], map: "users_email_unique")
  @@index([status], map: "users_status_idx")
  @@map("users")
}

model Post {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorUserId String  @map("author_user_id") @db.Uuid
  parentPostId String? @map("parent_post_id") @db.Uuid
  threadRootPostId String? @map("thread_root_post_id") @db.Uuid
  repostOfPostId String? @map("repost_of_post_id") @db.Uuid
  quoteOfPostId String? @map("quote_of_post_id") @db.Uuid
  contentText  String  @map("content_text")
  likeCount    Int     @default(0) @map("like_count")
  bookmarkCount Int    @default(0) @map("bookmark_count")
  shareCount   Int     @default(0) @map("share_count")
  status       String
  visibility   String
  pinnedAt     DateTime? @map("pinned_at") @db.Timestamptz(6)
  scheduledFor DateTime? @map("scheduled_for") @db.Timestamptz(6)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  author       User     @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  parentPost   Post?    @relation("PostParent", fields: [parentPostId], references: [id], onDelete: SetNull)
  replies      Post[]   @relation("PostParent")
  threadRoot   Post?    @relation("PostThreadRoot", fields: [threadRootPostId], references: [id], onDelete: SetNull)
  threadPosts  Post[]   @relation("PostThreadRoot")
  repostOf     Post?    @relation("PostRepost", fields: [repostOfPostId], references: [id], onDelete: SetNull)
  reposts      Post[]   @relation("PostRepost")
  quoteOf      Post?    @relation("PostQuote", fields: [quoteOfPostId], references: [id], onDelete: SetNull)
  quotes       Post[]   @relation("PostQuote")
  likes        PostLike[]
  bookmarks    PostBookmark[]

  @@index([authorUserId, createdAt], map: "posts_author_created_idx")
  @@index([status, publishedAt], map: "posts_status_published_idx")
  @@index([threadRootPostId, createdAt], map: "posts_thread_root_created_idx")
  @@index([repostOfPostId, quoteOfPostId, createdAt], map: "posts_repost_quote_idx")
  @@map("posts")
}

model PostLike {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt], map: "post_likes_user_created_idx")
  @@map("post_likes")
}

model PostBookmark {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt], map: "post_bookmarks_user_created_idx")
  @@map("post_bookmarks")
}

model ProfileSettings {
  userId                String   @id @map("user_id") @db.Uuid
  bio                   String?
  avatarUrl             String?  @map("avatar_url")
  links                 Json     @default("[]")
  visibility            String   @default("public")
  followerListVisibility String  @default("followers") @map("follower_list_visibility")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_settings")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  status      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, status, createdAt], map: "follows_following_idx")
  @@map("follows")
}

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("blocks")
}

model Mute {
  muterId  String   @map("muter_id") @db.Uuid
  mutedId  String   @map("muted_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  muter    User     @relation("MuteMuter", fields: [muterId], references: [id], onDelete: Cascade)
  muted    User     @relation("MuteMuted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
  @@map("mutes")
}

model AuthSession {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  refreshTokenId String    @unique @map("refresh_token_id")
  deviceId       String?   @map("device_id")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt], map: "auth_sessions_user_revoked_idx")
  @@index([expiresAt], map: "auth_sessions_expires_idx")
  @@map("auth_sessions")
}

model VerificationSession {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  provider           String
  providerSubject    String?   @map("provider_subject")
  providerSessionRef String?   @map("provider_session_ref")
  status             String
  failureCode        String?   @map("failure_code")
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "verification_sessions_user_idx")
  @@index([status], map: "verification_sessions_status_idx")
  @@map("verification_sessions")
}

model VerificationCallbackEvent {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider           String
  eventId            String   @map("event_id")
  userId             String   @map("user_id") @db.Uuid
  providerSessionRef String   @map("provider_session_ref")
  status             String
  payloadHash        String   @map("payload_hash")
  receivedAt         DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, eventId], map: "verification_callback_events_provider_event_unique")
  @@index([userId], map: "verification_callback_events_user_idx")
  @@index([provider, providerSessionRef], map: "verification_callback_events_session_idx")
  @@map("verification_callback_events")
}

model PasskeyChallenge {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  challengeType String    @map("challenge_type")
  challenge     String
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, challengeType, expiresAt], map: "passkey_challenges_user_type_idx")
  @@map("passkey_challenges")
}

model PasskeyCredential {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  credentialId String    @unique @map("credential_id")
  publicKey    String    @map("public_key")
  signCount    BigInt    @default(0) @map("sign_count")
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt], map: "passkey_credentials_user_idx")
  @@map("passkey_credentials")
}

model DomainEventOutbox {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId          String    @unique @map("event_id")
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion BigInt?   @map("aggregate_version")
  eventType        String    @map("event_type")
  payload          Json
  headers          Json      @default("{}")
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(6)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  publishAttempts  Int       @default(0) @map("publish_attempts")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([publishedAt, createdAt], map: "domain_event_outbox_unpublished_idx")
  @@map("domain_event_outbox")
}

model ConsumedDomainEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriberName String   @map("subscriber_name")
  eventId        String   @map("event_id")
  eventType      String   @map("event_type")
  status         String   @default("processed")
  attemptCount   Int      @default(0) @map("attempt_count")
  firstSeenAt    DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastAttemptAt  DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  lastError      String?  @map("last_error")
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([subscriberName, eventId], map: "consumed_domain_events_subscriber_event_unique")
  @@index([eventType, processedAt], map: "consumed_domain_events_event_type_idx")
  @@index([status, leaseExpiresAt], map: "consumed_domain_events_status_lease_idx")
  @@map("consumed_domain_events")
}

model MediaUploadSession {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  provider       String
  uploadUrl      String      @map("upload_url")
  objectKey      String      @unique @map("object_key")
  mimeType       String      @map("mime_type")
  fileSizeBytes  BigInt      @map("file_size_bytes")
  chunkSizeBytes Int         @map("chunk_size_bytes")
  status         String
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAssets    MediaAsset[]

  @@index([userId, createdAt], map: "media_upload_sessions_user_created_idx")
  @@index([status, expiresAt], map: "media_upload_sessions_status_expiry_idx")
  @@map("media_upload_sessions")
}

model MediaAsset {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId      String               @map("owner_user_id") @db.Uuid
  uploadSessionId  String               @map("upload_session_id") @db.Uuid
  mediaKind        String               @map("media_kind")
  mimeType         String               @map("mime_type")
  objectKey        String               @unique @map("object_key")
  processingStatus String               @map("processing_status")
  visibility       String
  caption          String?
  altText          String?              @map("alt_text")
  allowRemix       Boolean              @default(false) @map("allow_remix")
  sourceMediaAssetId String?            @map("source_media_asset_id") @db.Uuid
  readyAt          DateTime?            @map("ready_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner            User                 @relation("MediaOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  uploadSession    MediaUploadSession   @relation(fields: [uploadSessionId], references: [id], onDelete: Restrict)
  sourceMediaAsset MediaAsset?          @relation("MediaDerivatives", fields: [sourceMediaAssetId], references: [id], onDelete: SetNull)
  derivatives      MediaAsset[]         @relation("MediaDerivatives")
  carouselItems    MediaAssetCarouselItem[] @relation("MediaAssetCarousel")
  usedInCarousels  MediaAssetCarouselItem[] @relation("CarouselChildAsset")
  comments         MediaComment[]

  @@index([ownerUserId, createdAt], map: "media_assets_owner_created_idx")
  @@index([processingStatus, createdAt], map: "media_assets_processing_status_idx")
  @@map("media_assets")
}

model MediaAssetCarouselItem {
  mediaAssetId      String     @map("media_asset_id") @db.Uuid
  position          Int
  childMediaAssetId String     @map("child_media_asset_id") @db.Uuid
  mediaAsset        MediaAsset @relation("MediaAssetCarousel", fields: [mediaAssetId], references: [id], onDelete: Cascade)
  childMediaAsset   MediaAsset @relation("CarouselChildAsset", fields: [childMediaAssetId], references: [id], onDelete: Restrict)

  @@id([mediaAssetId, position])
  @@index([childMediaAssetId], map: "media_asset_carousel_child_idx")
  @@map("media_asset_carousel_items")
}

model MediaComment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaAssetId    String        @map("media_asset_id") @db.Uuid
  parentCommentId String?       @map("parent_comment_id") @db.Uuid
  authorUserId    String        @map("author_user_id") @db.Uuid
  bodyText        String        @map("body_text")
  status          String
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  mediaAsset      MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  parentComment   MediaComment? @relation("MediaCommentThread", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replyComments   MediaComment[] @relation("MediaCommentThread")
  author          User          @relation("MediaCommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([mediaAssetId, createdAt], map: "media_comments_asset_created_idx")
  @@index([authorUserId, createdAt], map: "media_comments_author_created_idx")
  @@map("media_comments")
}
